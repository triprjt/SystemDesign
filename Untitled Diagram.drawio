gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;id:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,         &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Unique identifier&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;parent:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,     &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Parent node id&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;children:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;&lt;span style=&quot;color: #d6d6dd;&quot;&gt;[]&lt;/span&gt;, &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Child node ids&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Node specific data&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;data:&lt;/span&gt; {&lt;/div&gt;&lt;div&gt;                name?&lt;span style=&quot;color: #d6d6dd;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;                params?&lt;span style=&quot;color: #d6d6dd;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;&lt;span style=&quot;color: #d6d6dd;&quot;&gt;[]&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;                returnType?&lt;span style=&quot;color: #d6d6dd;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;                source?&lt;span style=&quot;color: #d6d6dd;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,    &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// for imports&lt;/span&gt;&lt;/div&gt;&lt;div&gt;                specifiers?&lt;span style=&quot;color: #d6d6dd;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;&lt;span style=&quot;color: #d6d6dd;&quot;&gt;[]&lt;/span&gt; &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// for imports&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            },&lt;/div&gt;&lt;br&gt;&lt;div&gt;            &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Location in file&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;location:&lt;/span&gt; {&lt;/div&gt;&lt;div&gt;                &lt;span style=&quot;color: #d6d6dd;&quot;&gt;start:&lt;/span&gt; { &lt;span style=&quot;color: #d6d6dd;&quot;&gt;line:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt;, &lt;span style=&quot;color: #d6d6dd;&quot;&gt;column:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;                &lt;span style=&quot;color: #d6d6dd;&quot;&gt;end:&lt;/span&gt; { &lt;span style=&quot;color: #d6d6dd;&quot;&gt;line:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt;, &lt;span style=&quot;color: #d6d6dd;&quot;&gt;column:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt; }&lt;/div&gt;&lt;div&gt;            }&lt;/div&gt;&lt;div&gt;        }&lt;span style=&quot;color: #d6d6dd;&quot;&gt;]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    },&lt;/div&gt;&lt;br&gt;&lt;div&gt;    &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Quick lookup symbols&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    symbols: {&lt;/div&gt;&lt;div&gt;        exports: &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;&lt;span style=&quot;color: #d6d6dd;&quot;&gt;[]&lt;/span&gt;,      &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// Exported symbols&lt;/span&gt;&lt;/div&gt;&lt;div&gt;        declarations: &lt;span style=&quot;color: #d6d6dd;&quot;&gt;[&lt;/span&gt;{        &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// All declarations in file&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;name:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;type:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;string&lt;/span&gt;,      &lt;span style=&quot;color: #6d6d6d;font-style: italic;&quot;&gt;// &#39;function&#39;, &#39;class&#39;, &#39;variable&#39;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            &lt;span style=&quot;color: #d6d6dd;&quot;&gt;location:&lt;/span&gt; {&lt;/div&gt;&lt;div&gt;                &lt;span style=&quot;color: #d6d6dd;&quot;&gt;start:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;                &lt;span style=&quot;color: #d6d6dd;&quot;&gt;end:&lt;/span&gt; &lt;span style=&quot;color: #94c1fa;&quot;&gt;number&lt;/span&gt;&lt;/div&gt;&lt;div&gt;            }&lt;/div&gt;&lt;div&gt;        }&lt;span style=&quot;color: #d6d6dd;&quot;&gt;]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    }&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(216, 222, 233), rgb(42, 47, 56)); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 12px; font-weight: normal; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(216, 222, 233);&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="v0iwyNT79lTlcmo5SKfG-78">
